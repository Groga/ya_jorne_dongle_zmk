
/*
 * ------------------------------------------------------------------
 * Файл:      jorne_right.overlay
 * Версия:    1.0
 * Автор:     Evgeniy Moskovkin
 * Описание:  Правая половина Jorne (периферия в сплите).
 *            col-offset = 6, т.к. левая половина уже заняла
 *            колонки 0..5 в общей матрице (см. jorne_common.dtsi).
 *
 *            ИСПРАВЛЕНО по сравнению с исходником:
 *              - убран дублирующийся пин 5 в row-gpios (было 5,5,6,7,
 *                стало 4,6,7,8 — по аналогии с левой половиной;
 *                ОБЯЗАТЕЛЬНО сверьте с реальной платой!)
 *              - убран мусорный текст "qee" в конце файла
 * ------------------------------------------------------------------
 */

#include "../jorne_common/jorne_common.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 17 GPIO_ACTIVE_HIGH>   // col 0 (глобально станет col 6)
            , <&pro_micro 13 GPIO_ACTIVE_HIGH>   // col 1 (глобально col 7)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   // col 2 (глобально col 8)
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   // col 3 (глобально col 9)
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   // col 4 (глобально col 10)
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   // col 5 (глобально col 11)
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   // col 6 (запасной/не используется)
            ;

        // ПРОВЕРЬТЕ на плате: было "5,5,6,7" — дублирующийся пин 5
        // явная ошибка, ниже — предположение по аналогии с левой
        // половиной (платы обычно зеркальные и распаяны одинаково).
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 0
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 1
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 2
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 3 (большие пальцы)
            ;
    };
};

&default_transform {
    col-offset = <6>;   // правая половина начинается с 6-й глобальной колонки
};

