/*
 * Файл: jorne_right.overlay
 * Описание: Правая половина Jorne (44 клавиши / split 3x6_3 + боковые)
 */

#include "../jorne_common/jorne_common.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 14 GPIO_ACTIVE_HIGH>   // col 0 (Внутренняя колонка)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   // col 1
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   // col 2
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   // col 3
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   // col 4
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   // col 5
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>   // col 6 (Боковая внешняя: Win/Menu/AltGr)
            ;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

&default_transform {
    col-offset = <7>;
};
