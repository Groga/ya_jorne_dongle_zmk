/*
 * ------------------------------------------------------------------
 * Файл:      jorne_left.overlay
 * Версия:    3.0
 * Автор:     Evgeniy Moskovkin
 * Описание:  Левая половина Jorne (44 клавиши / split 3x6_3 + боковые).
 *            Столбцы (col-gpios) идут в РАЗВЁРНУТОМ порядке — это
 *            подтверждено тестами (аналогичный сдвиг был найден и
 *            исправлен на правой половине тем же способом).
 *            Строки (row-gpios) подтверждены реальным тестом нажатий
 *            через отладочный USB-лог (kscan_matrix_read).
 * ------------------------------------------------------------------
 */

#include "../jorne_common/jorne_common.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>  // COL 0 (P0.31)
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  // COL 1 (P0.29)
            , <&gpio0  2 GPIO_ACTIVE_HIGH>  // COL 2 (P0.02)
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  // COL 3 (P1.15)
            , <&gpio0 28 GPIO_ACTIVE_HIGH>  // COL 4 (P0.28)
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // COL 5 (P0.09)
            ;

        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW 0 (P0.22)
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW 1 (P0.24)
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW 2 (P1.00)
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW 3 (P0.11)
            ;
    };
};

&default_transform {
    col-offset = <0>;
};
