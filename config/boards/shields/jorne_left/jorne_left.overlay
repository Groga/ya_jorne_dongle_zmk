/*
 * Файл: jorne_right.overlay
 * Описание: Правая половина Jorne (44 клавиши / split 3x6_3 + боковые)
 */

#include "../jorne_common/jorne_common.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 16 GPIO_ACTIVE_HIGH>   // col 0 (Боковая внешняя)
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   // col 1 (Колонка Q / A / Z)
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   // col 2 (Колонка W / S / X)
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   // col 3 (Колонка E / D / C)
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   // col 4 (Колонка R / F / V)
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   // col 5 (Колонка T / G / B)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   // col 6 (Внутренняя колонка)
            ;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
