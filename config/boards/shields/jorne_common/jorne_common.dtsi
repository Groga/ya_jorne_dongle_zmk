/*
 * ------------------------------------------------------------------
 * Файл:      jorne_common.dtsi
 * Версия:    5.0
 * Автор:     Evgeniy Moskovkin
 * Описание:  Общий matrix-transform и physical-layout (для ZMK Studio).
 *            v4.0 — левая половина полностью подтверждена логами.
 *            v5.0 — правая половина проверена логом: исправлены внешние
 *            клавиши '/\ и большие пальцы (см. комментарий у map ниже).
 * ------------------------------------------------------------------
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;

        // ------------------------------------------------------------------
        // 2026-09-03 (Evgeniy Moskovkin): transform ЛЕВОЙ половины исправлен
        // по реальному USB-логу kscan_matrix_read. ВСЕ 22 клавиши левой
        // половины подтверждены построчно:
        //   ряд 0:  `=(0,0) Q=(0,1) W=(0,2) E=(0,3) R=(0,4) T=(0,5)
        //   ряд 1:  Ctrl=(1,0) A=(1,1) S=(1,2) D=(1,3) F=(1,4) G=(1,5)
        //   ряд 2:  Alt=(2,0) Z=(2,1) X=(2,2) C=(2,3) V=(2,4) B=(2,5)
        //   ряд 3:  Win=(3,0)      Tab=(3,3) Space=(3,4) Enter=(3,5)
        //
        // Итого от ОРИГИНАЛА (v2.0) реально изменились только две вещи:
        //   1. Win:            RC(0,6)              -> RC(3,0)
        //   2. Левые пальцы:   RC(3,0)/(3,1)/(3,2)  -> RC(3,3)/(3,4)/(3,5)
        // Ряды 1 и 2 в оригинале были ВЕРНЫ (внешняя колонка Ctrl/Alt в
        // начале своего ряда, буквы за ней по столбцам 1..5) — промежуточная
        // версия v3.0 их зря ломала, здесь они возвращены.
        //
        // 2026-09-03 — правая половина ПОЛНОСТЬЮ проверена логами. Реальная
        // электрическая карта (локальные row,col; главный блок использует
        // столбцы 0-4 и 6, столбец 5 НЕ используется):
        //   ряд 0:  Y=(0,0) U=(0,1) I=(0,2) O=(0,3) P=(0,4)  [=(0,6)
        //   ряд 1:  H=(1,0) J=(1,1) K=(1,2) L=(1,3) ;=(1,4)  '=(1,6)
        //   ряд 2:  N=(2,0) M=(2,1) ,=(2,2) .=(2,3) /=(2,4)  \=(2,6)
        //   пальцы: Esc=(3,0) Bspc=(3,1) Del=(3,2)
        //   Win:    отдельная клавиша RWIN/]/F12/Reset = (3,6) — зеркальная
        //           пара левой Win в (3,0). Именно её пользователь обвёл на
        //           фото красным овалом.
        // Правки правой части карты (с учётом col-offset=7):
        //   - [ (поз.12) сидит в лок. столбце 6 -> RC(0,12)->RC(0,13);
        //   - Win (поз.13) сидит в (3,6) -> RC(0,13)->RC(3,13);
        //   - ' (поз.25) и \ (поз.37) в столбце 6 -> RC(1,12)->RC(1,13),
        //     RC(2,12)->RC(2,13);
        //   - большие пальцы остаются RC(3,7)/(3,8)/(3,9) (лок. 0,1,2).
        // Итог: раскладка остаётся 44-клавишной, лишних позиций не добавляли.
        // Пин строки пальцев исправлен в jorne_right.overlay (D8 -> D7).
        // Столбец 5 правой половины (P0.10, NFC) по факту НЕ используется —
        // опция CONFIG_NFCT_PINS_AS_GPIOS в jorne_right.conf теперь не нужна,
        // но оставлена как безвредная страховка.
        // ------------------------------------------------------------------
        map = <
        RC(3,0) RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,13) RC(3,13)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,13)
                RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,13)
                                        RC(3,3) RC(3,4) RC(3,5)    RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Jorne 44-key";
        transform = <&default_transform>;

        keys
        = <&key_physical_attrs 100 100    0    0 0 0 0>
        , <&key_physical_attrs 100 100  100    0 0 0 0>
        , <&key_physical_attrs 100 100  200    0 0 0 0>
        , <&key_physical_attrs 100 100  300    0 0 0 0>
        , <&key_physical_attrs 100 100  400    0 0 0 0>
        , <&key_physical_attrs 100 100  500    0 0 0 0>
        , <&key_physical_attrs 100 100  600    0 0 0 0>
        , <&key_physical_attrs 100 100  800    0 0 0 0>
        , <&key_physical_attrs 100 100  900    0 0 0 0>
        , <&key_physical_attrs 100 100 1000    0 0 0 0>
        , <&key_physical_attrs 100 100 1100    0 0 0 0>
        , <&key_physical_attrs 100 100 1200    0 0 0 0>
        , <&key_physical_attrs 100 100 1300    0 0 0 0>
        , <&key_physical_attrs 100 100 1400    0 0 0 0>

        , <&key_physical_attrs 100 100    0  100 0 0 0>
        , <&key_physical_attrs 100 100  100  100 0 0 0>
        , <&key_physical_attrs 100 100  200  100 0 0 0>
        , <&key_physical_attrs 100 100  300  100 0 0 0>
        , <&key_physical_attrs 100 100  400  100 0 0 0>
        , <&key_physical_attrs 100 100  500  100 0 0 0>
        , <&key_physical_attrs 100 100  700  100 0 0 0>
        , <&key_physical_attrs 100 100  800  100 0 0 0>
        , <&key_physical_attrs 100 100  900  100 0 0 0>
        , <&key_physical_attrs 100 100 1000  100 0 0 0>
        , <&key_physical_attrs 100 100 1100  100 0 0 0>
        , <&key_physical_attrs 100 100 1200  100 0 0 0>

        , <&key_physical_attrs 100 100    0  200 0 0 0>
        , <&key_physical_attrs 100 100  100  200 0 0 0>
        , <&key_physical_attrs 100 100  200  200 0 0 0>
        , <&key_physical_attrs 100 100  300  200 0 0 0>
        , <&key_physical_attrs 100 100  400  200 0 0 0>
        , <&key_physical_attrs 100 100  500  200 0 0 0>
        , <&key_physical_attrs 100 100  700  200 0 0 0>
        , <&key_physical_attrs 100 100  800  200 0 0 0>
        , <&key_physical_attrs 100 100  900  200 0 0 0>
        , <&key_physical_attrs 100 100 1000  200 0 0 0>
        , <&key_physical_attrs 100 100 1100  200 0 0 0>
        , <&key_physical_attrs 100 100 1200  200 0 0 0>

        , <&key_physical_attrs 100 100  200  300 0 0 0>
        , <&key_physical_attrs 100 100  300  300 0 0 0>
        , <&key_physical_attrs 100 100  400  300 0 0 0>
        , <&key_physical_attrs 100 100  700  300 0 0 0>
        , <&key_physical_attrs 100 100  800  300 0 0 0>
        , <&key_physical_attrs 100 100  900  300 0 0 0>
        ;
    };
};
