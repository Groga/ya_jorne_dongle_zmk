dts
/*
 * ------------------------------------------------------------------
 * Файл:      jorne_common.dtsi
 * Версия:    1.0
 * Автор:     Evgeniy Moskovkin
 * Описание:  Общий matrix-transform для сплит-клавиатуры Jorne
 *            (левая половина + правая половина + донгл-центр).
 *            Подключается через #include во ВСЕ ТРИ шилда, чтобы
 *            у всех частей клавиатуры была ОДИНАКОВАЯ нумерация
 *            "key position". Это обязательное требование ZMK для
 *            сплит-клавиатур: без этого позиции левой и правой
 *            половинки накладываются друг на друга.
 *
 *            Раскладка соответствует уже существующему
 *            jorne_dongle.keymap: 6 колонок на половину в трёх
 *            основных рядах + по 3 клавиши на больших пальцах.
 *            Итого 6*3*2 + 3*2 = 42 позиции — ровно столько,
 *            сколько бindings в keymap.
 *
 *            ВАЖНО: физические номера колонок для ряда больших
 *            пальцев (RC(3, ...)) ниже — ориентировочные (2,3,4-й
 *            провод из семи). Их нужно проверить на реальной плате
 *            методом из раздела 4 этого документа и поправить при
 *            необходимости под свою распайку.
 * ------------------------------------------------------------------
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;   // 6 колонок слева + 6 колонок справа
        rows = <4>;       // 3 основных ряда + 1 ряд больших пальцев

        map = <
        // ---- Ряд 0: цифровой/верхний буквенный ряд ----------------------
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        // ---- Ряд 1: домашний ряд -----------------------------------------
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        // ---- Ряд 2: нижний буквенный ряд ----------------------------------
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        // ---- Ряд 3: большие пальцы (3 слева + 3 справа) -------------------
        RC(3,2) RC(3,3) RC(3,4)             RC(3,8) RC(3,9) RC(3,10)
        >;
    };
};
