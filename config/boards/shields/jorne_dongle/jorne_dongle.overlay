```dts
/*
 * ------------------------------------------------------------------
 * Файл:      jorne_dongle.overlay
 * Версия:    1.0
 * Автор:     Evgeniy Moskovkin
 * Описание:  Донгл (центральная часть сплита). Своих клавиш нет —
 *            используется "заглушка" mock-kscan. matrix-transform
 *            подключается ИЗ ТОГО ЖЕ общего файла jorne_common.dtsi,
 *            что и у обеих половинок — это обязательное требование
 *            ZMK (все части сплита должны иметь идентичный transform).
 * ------------------------------------------------------------------
 */

#include "../jorne_common/jorne_common.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
```
